# === SPHYNIX STORE TELEGRAM BOT CONFIG ===

# Token bot dari @BotFather
BOT_TOKEN=your-telegram-bot-token-here

# Override settings.js (opsional)
BOT_NAME="YS Auto Order Bot"
BOT_VERSION="2.0"
BOT_AUTHOR="Yasir"

# Zona waktu (disarankan Asia/Jakarta)
TZ=Asia/Jakarta

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=auto_order

# Store branding
STORE_NICKNAME="SEN PRO"
STORE_NAME="Sphynixstore"
PAYMENT_GATEWAY_LABEL="YSPAY"
ORDER_LOG_CHANNEL=
FLASH_SALE_DISCOUNT_PERCENT=0

QR_STRING=""
PAYMENT_EXPIRES_MINUTES=15
PAYMENT_GATEWAY=gopay
GOBIZ_EMAIL=
GOBIZ_PASSWORD=''

# Admin (opsional, isi salah satu)
ADMIN_IDS=2024984460
ADMIN_USERNAMES=Yasir_ID
# ADMIN_JSON=[{"id":"2024984460","username":"Yasir_ID"}]

# Akses publik /ceksnk (true/false)
ALLOW_USER_CEK_SNK=false
