# === SPHYNIX STORE TELEGRAM BOT CONFIG ===

# Token bot dari @BotFather
BOT_TOKEN=your-telegram-bot-token-here

# Override settings.js (opsional)
BOT_NAME="YS Auto Order Bot"
BOT_VERSION="2.0"
BOT_AUTHOR="Yasir"

# Zona waktu (disarankan Asia/Jakarta)
TZ=Asia/Jakarta

# MongoDB (opsional; kosongkan untuk file lokal)
MONGODB_URI=
MONGODB_DB=auto_order

# Store branding
STORE_NICKNAME="SEN PRO"
STORE_NAME="Sphynixstore"
PAYMENT_GATEWAY_LABEL="YSPAY"
CHANNEL_TARGET=
ORDER_LOG_CHANNEL=

QR_STRING=""
PAYMENT_EXPIRES_MINUTES=15
PAYMENT_GATEWAY=gopay
GOBIZ_EMAIL=
GOBIZ_PASSWORD=''

# Admin (opsional, isi salah satu)
ADMIN_IDS=2024984460
ADMIN_USERNAMES=Yasir_ID
# ADMIN_JSON=[{"id":"2024984460","username":"Yasir_ID"}]

# Akses publik /ceksnk (true/false)
ALLOW_USER_CEK_SNK=false

# Web storefront & dashboard (aktif secara default)
WEB_ENABLED=true
# Gunakan PORT dari hosting bila tersedia; WEB_PORT hanya untuk override
WEB_PORT=3000
# Token rahasia untuk membuka tab Admin di web (wajib dibuat kuat)
WEB_ADMIN_TOKEN=ganti-dengan-token-admin-yang-panjang-dan-acak
# Secret penandatangan sesi web (minimal 32 karakter, jangan dibagikan)
WEB_SESSION_SECRET=ganti-dengan-random-secret-minimal-32-karakter
